{
  "name": "wigglewild",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-dist.mjs dist",
    "preview": "node scripts/preview.mjs dist 8080",
    "smoke": "node scripts/smoke.mjs",
    "bot": "node scripts/bot.mjs",
    "anim": "node scripts/anim.mjs --count 96 --frames 720 --out shots/anim --clip 1,9,12,28,46",
    "mesh-test": "node --experimental-strip-types --no-warnings tests/mesh-test.ts 400",
    "verify": "npm run typecheck && npm run build && npm run check && npm run smoke && npm run smoke:meadow && npm run bot && npm run play-bot",
    "fuzz": "node scripts/anim.mjs --fuzz 200 --frames 720 --out shots/v030/fuzz",
    "mutation-test": "node --experimental-strip-types --no-warnings tests/mutation-test.ts 100",
    "design-test": "node --experimental-strip-types --no-warnings tests/design-test.ts 200",
    "editor-demo": "node scripts/editor-demo.mjs",
    "play-bot": "node scripts/play-bot.mjs",
    "player-course": "node scripts/player-course.mjs",
    "gamepad-test": "node scripts/gamepad-test.mjs",
    "smoke:meadow": "node scripts/smoke.mjs --extra \"&mode=meadow\""
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "three.quarks": "0.17.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
